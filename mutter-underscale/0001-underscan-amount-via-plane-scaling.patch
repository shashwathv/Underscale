diff --git a/src/backends/native/meta-kms-underscan.h b/src/backends/native/meta-kms-underscan.h
new file mode 100644
index 0000000..d11a2d4
--- /dev/null
+++ b/src/backends/native/meta-kms-underscan.h
@@ -0,0 +1,107 @@
+/*
+ * Underscan by scaling the primary plane into a centered, inset area of the
+ * CRTC. The helpers here are shared by the primary plane assignment and the
+ * hardware cursor positioning so both always agree on the geometry.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <math.h>
+
+#include "mtk/mtk.h"
+
+/* Largest fraction of the picture that may be given up to borders. */
+#define META_KMS_UNDERSCAN_MAX_AMOUNT 0.25
+
+/*
+ * The area of a @width x @height CRTC that the picture occupies when
+ * underscanning by @amount (0.0 = whole CRTC). Sizes are kept even and the
+ * area is centered.
+ */
+static inline void
+meta_kms_underscan_get_area (int           width,
+                             int           height,
+                             double        amount,
+                             MtkRectangle *area)
+{
+  int area_width, area_height;
+
+  if (amount <= 0.0)
+    {
+      *area = (MtkRectangle) { 0, 0, width, height };
+      return;
+    }
+
+  amount = MIN (amount, META_KMS_UNDERSCAN_MAX_AMOUNT);
+
+  area_width = ((int) round (width * (1.0 - amount))) & ~1;
+  area_height = ((int) round (height * (1.0 - amount))) & ~1;
+
+  *area = (MtkRectangle) {
+    .x = (width - area_width) / 2,
+    .y = (height - area_height) / 2,
+    .width = area_width,
+    .height = area_height,
+  };
+}
+
+/* Map a point in full CRTC coordinates into the underscanned area. */
+static inline void
+meta_kms_underscan_map_point (int     width,
+                              int     height,
+                              double  amount,
+                              int    *x,
+                              int    *y)
+{
+  MtkRectangle area;
+
+  if (amount <= 0.0 || width <= 0 || height <= 0)
+    return;
+
+  meta_kms_underscan_get_area (width, height, amount, &area);
+  *x = area.x + (int) round ((double) *x * area.width / width);
+  *y = area.y + (int) round ((double) *y * area.height / height);
+}
+
+/* Map a rectangle in full CRTC coordinates into the underscanned area. */
+static inline void
+meta_kms_underscan_map_rect (int           width,
+                             int           height,
+                             double        amount,
+                             MtkRectangle *rect)
+{
+  MtkRectangle area;
+  int x1, y1, x2, y2;
+
+  if (amount <= 0.0 || width <= 0 || height <= 0)
+    return;
+
+  meta_kms_underscan_get_area (width, height, amount, &area);
+
+  x1 = area.x + (int) round ((double) rect->x * area.width / width);
+  y1 = area.y + (int) round ((double) rect->y * area.height / height);
+  x2 = area.x + (int) round ((double) (rect->x + rect->width) *
+                             area.width / width);
+  y2 = area.y + (int) round ((double) (rect->y + rect->height) *
+                             area.height / height);
+
+  *rect = (MtkRectangle) {
+    .x = x1,
+    .y = y1,
+    .width = x2 - x1,
+    .height = y2 - y1,
+  };
+}
