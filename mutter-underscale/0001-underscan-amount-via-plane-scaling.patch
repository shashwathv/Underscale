+static gboolean
+meta_monitor_manager_handle_set_underscan_amount (MetaDBusDisplayConfig *skeleton,
+                                                  GDBusMethodInvocation *invocation,
+                                                  const char            *connector,
+                                                  double                 amount,
+                                                  MetaMonitorManager    *manager)
+{
+  MetaMonitorManagerClass *klass = META_MONITOR_MANAGER_GET_CLASS (manager);
+  MetaMonitor *monitor;
+  double old_amount;
+  g_autoptr (GError) error = NULL;
+
+  if (!klass->set_underscan_amount)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_NOT_SUPPORTED,
+                                             "Underscan is not supported by this backend");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  if (!isfinite (amount) || amount < 0.0 || amount > 0.25)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_INVALID_ARGS,
+                                             "Underscan amount must be between 0.0 and 0.25");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  monitor = meta_monitor_manager_get_monitor_from_connector (manager,
+                                                             connector);
+  if (!monitor)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_INVALID_ARGS,
+                                             "Unknown connector '%s'",
+                                             connector);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  if (meta_monitor_is_builtin (monitor))
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_NOT_SUPPORTED,
+                                             "Underscan only applies to external displays");
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  old_amount = meta_monitor_manager_get_underscan_amount (manager, connector);
+
+  if (amount > 0.0)
+    {
+      g_hash_table_insert (manager->underscan_amounts,
+                           g_strdup (connector),
+                           g_memdup2 (&amount, sizeof (double)));
+    }
+  else
+    {
+      g_hash_table_remove (manager->underscan_amounts, connector);
+    }
+
+  if (!klass->set_underscan_amount (manager, monitor, amount, &error))
+    {
+      if (old_amount > 0.0)
+        {
+          g_hash_table_insert (manager->underscan_amounts,
+                               g_strdup (connector),
+                               g_memdup2 (&old_amount, sizeof (double)));
+        }
+      else
+        {
+          g_hash_table_remove (manager->underscan_amounts, connector);
+        }
+
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED,
+                                             "%s", error->message);
+      return G_DBUS_METHOD_INVOCATION_HANDLED;
+    }
+
+  meta_dbus_display_config_complete_set_underscan_amount (skeleton,
+                                                          invocation);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
 static void
 monitor_manager_setup_dbus_config_handlers (MetaMonitorManager *manager)
 {
+  g_signal_connect_object (manager->display_config,
+                           "handle-set-underscan-amount",
+                           G_CALLBACK (meta_monitor_manager_handle_set_underscan_amount),
+                           manager, G_CONNECT_DEFAULT);
   g_signal_connect_object (manager->display_config, "handle-get-resources",
                            G_CALLBACK (meta_monitor_manager_handle_get_resources),
                            manager, G_CONNECT_DEFAULT);
